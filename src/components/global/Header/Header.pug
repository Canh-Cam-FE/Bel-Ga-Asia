header.header
    .header-wrapper

        // Left Menu
        .menu-left
            +HeaderMenu([
                'ABOUT US',
                'PRODUCTS AND CERTIFICATE',
                'SUSTAINABILITY'
            ], "menu-item")

        // Logo
        .header-logo
            .img-wrapper(class="w-full")
                .img(class="img-ratio")
                    +PugImg("./img/Logo.png")

        // Right Menu
        .menu-right
            +HeaderMenu([
                'NEWS',
                'CAREER',
                'CONTACT US'
            ], "menu-item")

            // Desktop
            .header-actions(class="flex-center gap-2")
                .header-search.btn.btn-search
                    i.fa-light.fa-magnifying-glass
                    .header-search-form-desktop#header-search-form-desktop
                        .close.flex.items-center.justify-center.absolute.top-4.right-8.bg-white.text-3xl.text-primary-1.rounded-3.cursor-pointer(class="w-12.5 h-12.5")
                            i.fa-light.fa-xmark
                        .container
                            .wrap-form-search-product
                                .productsearchbox
                                    input(type="text" placeholder="Search...")
                                    button
                                        i.fa-regular.fa-magnifying-glass


                .header-language.btn.btn-language
                    +HeaderLanguage()
                    i.fa-light.fa-chevron-down

    // Mobile menu
    .header-mobile-wrapper
        .header-actions(class="w-full flex gap-2")
            .header-search.btn.btn-search
                .header-search-form-mobile#header-search-form-mobile
                    .container
                        .wrap-form-search-product
                            .productsearchbox
                                input(type="text" placeholder="Search...")
                                button
                                    i.fa-regular.fa-magnifying-glass

            .header-language.btn.btn-language
                +HeaderLanguage()
                i.fa-light.fa-chevron-down


        .menu-mobile
            +HeaderMenu([
                'ABOUT US',
                'PRODUCTS AND CERTIFICATE',
                'SUSTAINABILITY',
                'NEWS',
                'CAREER',
                'CONTACT US'
            ], "mobile-menu-item")

    .header-hamburger
        span
        span
        span
        #pulseMe
            .bar.left
            .bar.top
            .bar.right
            .bar.bottom