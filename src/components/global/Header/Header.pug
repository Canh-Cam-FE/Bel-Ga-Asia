header.header
    .header-wrapper

        // Left Menu
        .menu-left
            +HeaderMenu([
                'ABOUT US',
                'PRODUCTS AND CERTIFICATE',
                'SUSTAINABILITY'
            ], "menu-item")

        // Logo
        .header-logo
            .img-wrapper(class="w-full h-full")
                .img(class="img-ratio")
                    +PugImg("./img/Logo.png")

        // Right Menu
        .menu-right
            +HeaderMenu([
                'NEWS',
                'CAREER',
                'CONTACT US'
            ], "menu-item")

            .header-actions(class="flex-center gap-2")
                .header-search.btn.btn-search
                    i.fa-light.fa-magnifying-glass

                .header-language.btn.btn-language
                    +HeaderLanguage()
                    i.fa-light.fa-chevron-down

        // Mobile
        .header-hamburger
            span
            span
            span