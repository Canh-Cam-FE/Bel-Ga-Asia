mixin subscribeForm()
    .subscribe
        .subscribefrm
            input.subscribeemail(type="text" placeholder="Nhập email của bạn...")
            button.subscribebutton Gửi
mixin PugImg(url="./img/1.jpg")
    img(data-src=url, alt="" class="lozad " + attributes.class)
mixin btnViewAll(text="Xem thêm")
    a(href="" x-link class='btn-primary-2 btn ' + attributes.class)
        span=text
        img(src=imgButton, alt="" class="w-5 h-5 svg")
mixin HeaderLanguageVertical()
    ul 
        li.wpml-ls-item
            a(href="") 
                span.wpml-ls-native VN
        ul 
            li 
                a(href="") 
                    span EN
mixin HeaderLanguageHorizontal()
    ul 
        li.wpml-ls-item
            a(href="") 
                span.wpml-ls-native VN
        li.wpml-ls-item
            a(href="") 
                span.wpml-ls-native VN
mixin BtnPrimary(text="")
    a(href="" class='btn-primary btn ' + attributes.class)
        span=text

mixin HeaderMenu(menu = [], className = '')
    .header-menu(class=className)
        ul
            each item in menu
                li.menu-item-has-children
                    a.header-link(href="")= item

mixin btn-primary(title, className, iconString, iconPosition)
    - className = className || ''
    - iconString = iconString || '<i class="fa-light fa-arrow-right"></i>'
    - iconPosition = iconPosition || 'right'
    - title = title || 'Xem thêm'

    - className += ' btn-primary '

    a.btn(class=className)
        if iconPosition === 'left'
            != unescape(iconString)
            != unescape(title)
        else
            != unescape(title)
            if iconString
                != unescape(iconString)
        block


mixin BtnPrimaryOption(opts={})
    - 
        const {
        tag= "a",
        text = "Discover more",
        option = "btn-primary-2",
        href = "#!",
        appearance = "appearance-pill"||"",
        size = "size-sm"||""
        } = opts
    #{tag}(href=tag === "a" ? href : null, class=["btn", option, appearance, size, attributes.class])
        span=text
        .block-icon 
            if block 
                block 
            else 
                i(class="fa-sharp-duotone fa-regular fa-arrow-up-right")


