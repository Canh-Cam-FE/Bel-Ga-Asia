section.about-values.section-py
    .container
        .section-wrapper(class="flex-center flex-col gap-4 md:gap-10")
            .section-title
                h2.title
                    .text(class="heading-1-subpage text-primary-4 font-bold uppercase")
                        | Core Values

            .section-content
                .grid(class="grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 items-stretch gap-10")
