section.about-values.section-py
    .container
        .section-wrapper(class="flex-center flex-col gap-4 md:gap-10")
            .section-title
                h2.title
                    .text(class="heading-1-subpage text-primary-4 font-bold uppercase")
                        | Core Values

            .section-content
                .grid
                    -for(i=0;i<5;i++)
                        .item-container
                            .item-content(class="flex-center flex-col gap-4 md:gap-5 w-full h-full")
                                .item-img(class="w-[45%]")
                                    .img(class="img-ratio aspect-square")
                                        +PugImg()

                                .item-text(class="flex-center flex-col flex-1 gap-3")
                                    .text-title
                                        h3.title
                                            .text(class="heading-4 text-primary-3 font-bold")
                                                | Quality
                                    .text-desc(class="flex-1")
                                        p.desc
                                            .text(class="body-2 text-Utility-gray-950 text-justify")
                                                | We are committed to delivering consistent superior quality Day Old Chicks and Day Old Layers across Asia.
