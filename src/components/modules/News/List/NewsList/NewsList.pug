section.newslist.section-py(class="relative bg-[linear-gradient(180deg,#FFFBF0_0%,#FFF_100%)] z-3")
    .container
        .section-wrapper(class="relative flex flex-col gap-10 -mt-60" data-aos="fade-up")
            .section-header(class="flex flex-col gap-10" data-aos="fade-up")
                .category
                    ul.category-list.flex-center.flex-wrap.gap-5
                        each item, i in ['All', 'Vietnam', 'Cambodia', 'Myanmar']
                            li.list-item.flex.items-center
                                a.item(class=i===0 ? 'active' : '')= item

            .section-news-slider.swiper-column-auto.auto-3-column.allow-touchMove(class=`swiper-column-auto-id-1` data-aos="fade-up" data-aos-delay="150")
                .swiper
                    .swiper-wrapper
                        -for(i=0;i<3;i++)
                            .swiper-slide(data-aos="fade-up" data-aos-delay=`${i * 150}`)
                                .news-card(class="h-full flex flex-col bg-Utility-white rounded-5 overflow-hidden")
                                    .card-img
                                        .img-wrapper.overflow-hidden
                                            .img(class="img-ratio ratio:pt-[280_440]")
                                                +PugImg()

                                    .card-content
                                        .news-meta
                                            .country
                                                p.text-country
                                                    .text(class="body-3 text-primary-1")
                                                        | Vietnam
                                            .date
                                                p.text-date
                                                    .text
                                                        | May 22, 2026

                                        .card-title(class="flex-1")
                                            h2.text-title
                                                .text(class="heading-3 text-primary-1 font-bold")
                                                    | Bel Gà, De Heus, TTC Energy and Hung Nhon - Join Forces to Scales Up Solar Energy Development

                                        .section-news-link
                                            p.text-link
                                                .text(class="body-3 text-primary-1")
                                                    | Read more
                                            i.fa-light.fa-arrow-right



            .pagination-wrapper(class="flex-center mt-4")
                +Pagination()