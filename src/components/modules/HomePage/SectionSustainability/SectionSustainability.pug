section.section-sustainability

    .banner-image
        .banner-overlay
        .img
            +PugImg()

    .container
        .section-sustainability-content

            .section-sustainability-top
                .section-sustainability-left
                    h2.section-sustainability-title
                        | Together We Hatch
                        br
                        | a Greener Future

                    p.section-sustainability-text
                        | Register your email to receive information from us.

                .section-sustainability-right
                    form.section-sustainability-form
                        .section-sustainability-form-wrap
                            input.section-sustainability-input(
                                type="email"
                                placeholder="Type your email"
                            )

                            button.section-sustainability-btn(type="submit")
                                | Subscribe

            .section-sustainability-divider

            .section-sustainability-contact

                button.section-sustainability-arrow.section-sustainability-arrow-prev(type="button")
                    span.material-symbols-outlined west

                .section-sustainability-list

                    .section-sustainability-item
                        .section-sustainability-country
                            img(
                                src="./img/flag-vietnam.png"
                                alt="Vietnam"
                            )

                        ul.section-sustainability-info
                            li
                                .icon
                                    span.material-symbols-outlined location_on

                                .content
                                    | Lot B3,3A, D11 Street, Thanh Thanh Cong Industrial Park,
                                    br
                                    | Trang Bang Ward, Tay Ninh Province, Vietnam

                            li
                                .icon
                                    span.material-symbols-outlined mail

                                .content
                                    a(href="mailto:info.vietnam@belgaasia.com")
                                        | info.vietnam@belgaasia.com

                            li
                                .icon.facebook
                                    i.fa-brands.fa-facebook-f

                                .content
                                    a(href="#")
                                        | Bel Gà Vietnam

                    .section-sustainability-item
                        .section-sustainability-country
                            img(
                                src="./img/flag-cambodia.png"
                                alt="Cambodia"
                            )

                        ul.section-sustainability-info
                            li
                                .icon
                                    span.material-symbols-outlined location_on

                                .content
                                    | Spring Plaza Building, No.2175,
                                    br
                                    | 5th Floor, Room A501,
                                    br
                                    | St.2004, Phnom Penh

                            li
                                .icon
                                    span.material-symbols-outlined mail

                                .content
                                    a(href="mailto:info.cambodia@belgaasia.com")
                                        | info.cambodia@belgaasia.com

                            li
                                .icon.facebook
                                    i.fa-brands.fa-facebook-f

                                .content
                                    a(href="#")
                                        | Bel Gà Cambodia

                    .section-sustainability-item
                        .section-sustainability-country
                            img(
                                src="./img/flag-myanmar.png"
                                alt="Myanmar"
                            )

                        ul.section-sustainability-info
                            li
                                .icon
                                    span.material-symbols-outlined location_on

                                .content
                                    | 312,313,314 - Myaung Dagar Industrial Zone,
                                    br
                                    | Hmawbi Township,
                                    br
                                    | Yangon Division, Myanmar

                            li
                                .icon
                                    span.material-symbols-outlined mail

                                .content
                                    a(href="mailto:info.myanmar@belgaasia.com")
                                        | info.myanmar@belgaasia.com

                            li
                                .icon.facebook
                                    i.fa-brands.fa-facebook-f

                                .content
                                    a(href="#")
                                        | Bel Gà Myanmar

                button.section-sustainability-arrow.section-sustainability-arrow-next(type="button")
                    span.material-symbols-outlined east

            .section-sustainability-divider

            .section-sustainability-bottom
                .section-sustainability-slogan
                    | BEL GÀ ASIA - QUALITY CHICKS, HEALTHY LIFE

                p.section-sustainability-copyright
                    | © 2026 BEL GA ASIA. All Rights Reserved. Website designed by CanhCam.