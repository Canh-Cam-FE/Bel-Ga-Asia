section.products-contact.pb-20
    .container
        .section-wrapper(class="w-full flex gap-17 rounded-5 border-2 bg-secondary-6 shadow-1 overflow-hidden")
            .thumbnail(class="relative w-[36%]")
                .img-wrapper
                    .img(class="img-ratio ratio:pt-[650_504]")
                        +PugImg()

                .thumbnail-text(class="absolute bottom-0 inset-x-0 flex flex-col gap-2 px-5 pb-8")
                    h2.text-title
                        .text(class="heading-1-60 text-Utility-white font-bold uppercase")
                            | DISCOVER MORE ABOUT OUR PRODUCTS
                    p.text-desc
                        .text(class="body-2 text-Utility-white")
                            | Please full fill your details to access the brochure.

            .contact-form