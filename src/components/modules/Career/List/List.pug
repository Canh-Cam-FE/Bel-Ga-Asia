section.careerlist-banner
    +PageBanner("Career")

section.career-list-1.section.relative(class="relative rem:min-h-[680px] flex items-center z-3 -mt-60" setbackground="https://picsum.photos/1600/900")
    .mask(class="absolute h-full left-0 top-0")
    .container.relative
        .wrapper(class="rem:max-w-[600px] w-full")
            h2.title(class="heading-1-subpage text-primary-1") Môi trường làm việc
            .description(class='[&_*+*]:mt-5 mt-5')
