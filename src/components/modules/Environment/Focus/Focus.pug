section.environment-focus(class="relative pb-6 z-2 bg-[linear-gradient(180deg,#FFFBF0_0%,#FFF_100%)]")
    .container
        .section-wrapper(class="flex-center flex-col gap-6")
            .section-heading
                h2.heading
                    .text(class="heading-1-subpage text-primary-4 text-center font-bold")
                        | OUR FOCUS AREAS

            .section-content
                .grid
                    -for(i=0;i<5;i++)
                        .item-container
                            .item-content(class="flex-center flex-col gap-4 md:gap-5 w-full h-full")
                                .item-img(class="w-[40.32%]")
                                    .img(class="img-ratio aspect-square")
                                        +PugImg()

                                .item-text(class="flex-center flex-col flex-1 gap-3")
                                    .text-title
                                        h3.title
                                            .text(class="heading-4 text-primary-1 font-bold text-center")
                                                | Sustainable Agriculture & Raw Materials

                                    .text-desc(class="flex-1")
                                        p.desc
                                            .text(class="body-2 text-Utility-gray-950 text-justify")
                                                | We promote clean energy, improve energy efficiency, and reduce greenhouse gas emissions.
