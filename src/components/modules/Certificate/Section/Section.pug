section.certificate-section(class="relative section-py bg-[linear-gradient(180deg,#FFFBF0_0%,#FFF_100%)] z-3")
    .container
        .section-wrapper(class="flex-center flex-col gap-10")
            .section-title(class="flex-center flex-col gap-6")
                .section-heading
                    h2.heading
                        .text(class="heading-1-subpage text-primary-4 text-center font-bold uppercase")
                            | Our Certificates

            .section-content(class="flex flex-col gap-10")
                .certification-box
                    .box-upper(class="w-full flex gap-10")
                        .box-upper-left(class="w-[21%] flex flex-col gap-5")
                            .logo
                                .img-wrapper
                                    .img(class="img-ratio aspect-square")
                                        +PugImg()

                            .certification-year(class="flex-center py-3.5 bg-primary-3 rounded-2")
                                .text(class="heading-4 text-white font-bold")
                                    | 2024 to Now

                        .box-upper-right(class="w-full flex flex-col gap-4")
                            .box-title(class="border-b border-primary-4 pb-4")
                                h2.title
                                    .text(class="heading-2 text-primary-1 font-bold")
                                        | GLOBAL SMART LIVESTOCK PRACTICES (GLOBAL S.L.P)
                            .box-desc
                                p.desc
                                    .text(class="body-2 text-Utility-gray-950")
                                        span(class="font-bold") GLOBAL S.L.P
                                        |  is an internationally recognized certification that promotes safe, sustainable, and responsible production through food safety, biosecurity, environmental responsibility, animal health & welfare, worker health & safety, traceability, and continuous improvement. It applies specifically to livestock production.

                            .box-item-title
                                h3.item-title
                                    .text(class="heading-3 text-primary-3 font-bold")
                                        | KEY FOCUS AREAS
                            .box-item-item(class="flex gap-5")
                                -for(i=0;i<6;i++)
                                    .item(class="w-[15%]")
                                        .img-wrapper
                                            .img(class="img-ratio aspect-square")
                                                +PugImg()
                            .box-item-title
                                h3.features-title
                                    .text(class="heading-3 text-primary-3 font-bold")
                                        | WHAT GLOBAL S.L.P. MEANS FOR OUR CUSTOMERS


                    .box-lower(class="mt-4")
                        .section-content
                            .grid
                                -for(i=0;i<5;i++)
                                    .item-container
                                        .item-content(class="w-full h-full flex-center flex-col gap-4 md:gap-5")
                                            .item-img(class="w-[34.48%]")
                                                .img(class="img-ratio aspect-square")
                                                    +PugImg()

                                            .item-text(class="flex-center flex-col flex-1 gap-3")
                                                .text-title
                                                    h3.title
                                                        .text(class="heading-4 text-primary-1 font-bold whitespace-nowrap")
                                                            | Consistent Product Quality
                                                .text-desc(class="flex-1")
                                                    p.desc
                                                        .text(class="body-2 text-Utility-gray-950 text-justify")
                                                            | Customers can be confident that their chicks are produced under internationally recognized standards for animal welfare and responsible farming.
