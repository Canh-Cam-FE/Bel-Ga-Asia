section.certificate-section
    .container
        .section-wrapper(class="flex-center flex-col gap-10")
            .section-title(class="flex-center flex-col gap-6")
                .section-heading
                    h2.heading
                        .text(class="heading-1-subpage text-primary-4 text-center font-bold")
                            | Our Certificates

            .section-content
                .certification-box
                    .box-upper(class="w-full flex gap-10")
                        .box-upper-left(class="w-[15.714%] flex flex-col gap-5")
                            .logo
                                .img-wrapper
                                    .img(class="img-ratio aspect-square")
                                        +PugImg()

                            .certification-year
                                .text(class="heading-4 text-white font-bold")
                                    | 2024 to Now

                        .box-upper-right(class="flex flex-col gap-4")
                            .box-title(class="border-b border-primary-4 pb-4 mb-4")
                                h2.title
                                    .text(class="heading-2 text-primary-1 font-bold")
                                        | GLOBAL SMART LIVESTOCK PRACTICES (GLOBAL S.L.P)
                            .box-desc
                                p.desc
                                    .text(class="body-2 text-Utility-gray-950")
                                        span(class="font-bold") GLOBAL S.L.P
                                        |  is an internationally recognized certification that promotes safe
                            .box-item-title
                                h3.item-title
                                    .text(class="heading-3 text-primary-3 font-bold")
                                        | KEY FOCUS AREAS
                            .box-item-item(class="flex gap-5")
                                -for(i=0;i<6;i++)
                                    .item(class="w-[15%]")
                                        .img-wrapper
                                            .img(class="img-ratio aspect-square")
                                                +PugImg()

                    .box-lower(class="")
                        h3.features-title
                            .text(class="heading-3 text-primary-3 font-bold")
                                | WHAT GLOBAL S.L.P. MEANS FOR OUR CUSTOMERS


                        .section-content
                            .grid(class="grid-cols-1 sm:grid-cols-2 lg:grid-cols-5")
                                -for(i=0;i<5;i++)
                                    .item-container
                                        .item-img(class="w-[45%]")
                                            .img(class="img-ratio aspect-square")
                                                +PugImg()
                                        .item-text(class="flex-center flex-col gap-3")
                                            h3.text-title
                                                .text(class="heading-4 text-primary-3 font-bold")
                                                    | Quality
                                            p.text-desc
                                                .text(class="body-2 text-Utility-gray-950 text-justify")
                                                    | We are committed to delivering consistent superior quality Day Old Chicks and Day Old Layers across Asia.


